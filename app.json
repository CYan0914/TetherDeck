{
  "expo": {
    "name": "TetherDeck",
    "slug": "claude-remote",
    "version": "1.0.4",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "clauderemote",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.cyan0914.clauderemote",
      "supportsTablet": false,
      "buildNumber": "1",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSLocalNetworkUsageDescription": "TetherDeck connects to the bridge server running on your own computer (over your local network or Tailscale) so you can control Claude Code from your phone.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#111418"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#111418"
        }
      ],
      "expo-status-bar",
      [
        "expo-audio",
        {
          "microphonePermission": "TetherDeck uses the microphone only while you hold the mic button to dictate a message."
        }
      ]
    ],
    "owner": "cyan0914",
    "extra": {
      "eas": {
        "projectId": "e5a2d941-e2ce-4f3c-bc10-04cf83d00b59"
      }
    }
  }
}
