# App Store Connect API key, used only by `eas submit` to upload builds.
# Create one at https://appstoreconnect.apple.com/access/integrations/api
# then drop the .p8 next to your credentials (ios-creds/ is gitignored).
#
#   ASC_API_KEY_PATH=./ios-creds/AuthKey_XXXXXXXXXX.p8
#   ASC_API_KEY_ID=XXXXXXXXXX
#   ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
